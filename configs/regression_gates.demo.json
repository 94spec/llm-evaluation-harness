{
  "name": "Synthetic regression policy",
  "version": "demo-1",
  "rules": [
    {
      "id": "schema-validity",
      "metric": "overall.schema_validity",
      "operator": "gte",
      "value": 0.99,
      "severity": "block"
    },
    {
      "id": "critical-flag-recall",
      "metric": "families.violation_flags.metrics.critical_recall",
      "operator": "gte",
      "value": 0.98,
      "severity": "block"
    },
    {
      "id": "qa-macro-f1-no-material-drop",
      "metric": "families.qa_scorecard.metrics.criterion_macro_f1",
      "operator": "max_drop",
      "value": 0.01,
      "severity": "block"
    },
    {
      "id": "summary-content-recall-no-material-drop",
      "metric": "families.deal_summary.metrics.content_unit_recall",
      "operator": "max_drop",
      "value": 0.02,
      "severity": "block"
    },
    {
      "id": "weighted-score-mae-no-material-rise",
      "metric": "families.qa_scorecard.metrics.recomputed_weighted_score_mae",
      "operator": "max_increase",
      "value": 0.5,
      "severity": "block"
    },
    {
      "id": "p95-latency",
      "metric": "operations.latency_ms.p95",
      "operator": "lte",
      "value": 12000,
      "severity": "warn"
    },
    {
      "id": "cost-per-1000",
      "metric": "operations.estimated_cost.cost_per_1000_records",
      "operator": "lte",
      "value": 25,
      "severity": "warn"
    }
  ]
}

